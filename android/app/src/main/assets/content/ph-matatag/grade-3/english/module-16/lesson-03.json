 "introduction": "Some nouns change more! Words ending in -ch, -sh, -x add -es. Words ending in -y become -ies!",
 "storyIntro": "Milo scratches his head. \"One box, two boxes! One baby, two babies! English is tricky — let's practice!\"",
 "scene": {
  "character": "Milo the Cat",
  "setting": "Word Workshop"
 },
 "vocabulary": [
  {
   "term": "-es plural",
   "definition": "Add -es to words ending in -ch, -sh, -s, -x: box → boxes."
  },
  {
   "term": "-ies plural",
   "definition": "Change -y to -ies when the letter before is a consonant: baby → babies."
  }
 ],
