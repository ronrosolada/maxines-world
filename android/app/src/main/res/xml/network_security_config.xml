<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- All network traffic must be HTTPS. Optional personal-use media is served
         by the home media server (e.g. Caddy) over TLS on the trusted LAN;
         cleartext HTTP is not permitted. If the media server presents an
         internal/private CA rather than a publicly trusted certificate, add it
         as a trust anchor here, e.g.:
             <domain-config>
                 <domain includeSubdomains="true">10.10.10.33</domain>
                 <trust-anchors><certificates src="@raw/homelab_ca"/></trust-anchors>
             </domain-config>
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
